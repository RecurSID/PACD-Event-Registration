{
  "name": "primark-event-registration",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch server.js",
    "start": "node --env-file=.env server.js",
    "test": "node --env-file-if-exists=.env.test --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "import-orgs": "node --env-file=.env scripts/import-orgs.js",
    "seed:demo": "node --env-file=.env scripts/seed-demo.js",
    "db:apply": "node --env-file=.env scripts/apply-migration.js",
    "smoke:attendance": "node --env-file=.env scripts/smoke-attendance.js",
    "backup": "node --env-file=.env scripts/backup.js",
    "backup:verify": "node scripts/verify-backup.js",
    "restore:storage": "node --env-file=.env scripts/restore-storage.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "html5-qrcode": "^2.3.8",
    "jszip": "^3.10.1",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "pg": "^8.23.1",
    "supertest": "^7.2.2"
  }
}
